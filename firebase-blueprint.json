{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Road project infrastructure metadata and metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 255 },
        "client": { "type": "string", "maxLength": 255 },
        "consultant": { "type": "string", "maxLength": 255 },
        "contractor": { "type": "string", "maxLength": 255 },
        "signDate": { "type": "string", "maxLength": 50 },
        "startDate": { "type": "string", "maxLength": 50 },
        "origDays": { "type": "string", "maxLength": 50 },
        "eotDays": { "type": "string", "maxLength": 50 },
        "variation": { "type": "string", "maxLength": 50 },
        "origAmount": { "type": "string", "maxLength": 50 },
        "lengthKm": { "type": "string", "maxLength": 50 },
        "classification": { "type": "string", "maxLength": 100 },
        "contractType": { "type": "string", "maxLength": 100 },
        "programDirectorate": { "type": "string", "maxLength": 100 },
        "pmo": { "type": "string", "maxLength": 100 },
        "physicalProgress": { "type": "string", "maxLength": 50 },
        "provisionalSum": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "name", "client"]
    },
    "User": {
      "title": "User",
      "description": "System user account profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 255 },
        "displayName": { "type": "string", "maxLength": 255 },
        "role": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid", "email"]
    },
    "Approval": {
      "title": "Approval",
      "description": "Variance approval request entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "projectId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "projectId"]
    },
    "Config": {
      "title": "Config",
      "description": "System taxonomy configuration",
      "type": "object",
      "properties": {
        "pmos": { "type": "string", "maxLength": 500 },
        "directorates": { "type": "string", "maxLength": 500 }
      }
    },
    "DeletedProject": {
      "title": "DeletedProject",
      "description": "Log of permanently deleted project IDs to ensure real-time global removal across all client devices and users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "deletedAt": { "type": "string", "maxLength": 100 },
        "deletedBy": { "type": "string", "maxLength": 255 },
        "projectName": { "type": "string", "maxLength": 255 }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Collection of road construction projects"
    },
    "/deleted_projects/{deletedProjectId}": {
      "schema": { "$ref": "#/entities/DeletedProject" },
      "description": "Collection of tombstoned project IDs for universal multi-user deletion synchronization"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of user profile entries"
    },
    "/approvals/{approvalId}": {
      "schema": { "$ref": "#/entities/Approval" },
      "description": "Collection of variance approval requests"
    },
    "/config/{configId}": {
      "schema": { "$ref": "#/entities/Config" },
      "description": "Collection of global app taxonomy config"
    }
  }
}
