# ==============================================================================
# Ethiopian Roads Administration - Ethio Telecom cPanel Apache Configuration
# Handles Single Page Application (SPA) routing, gzip compression, and API proxy
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow existing files or directories to be served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route /api/ requests to api.php if PHP backend is used on shared hosting
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteCond %{DOCUMENT_ROOT}/api.php -f
  RewriteRule ^api/(.*)$ /api.php?endpoint=$1 [QSA,L]

  # Fallback for all other frontend routes to index.html (SPA client routing)
  RewriteRule ^ index.html [L]
</IfModule>

# MIME type and UTF-8 encoding declarations for Ethio Telecom servers
AddDefaultCharset UTF-8
AddType application/javascript .js
AddType text/css .css
AddType image/svg+xml .svg
AddType application/json .json

# Enable GZIP compression on Apache/cPanel
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>

# Cache-Control headers
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>
