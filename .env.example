# Ethio Telecom Web Hosting Traditional MySQL Database Configuration
# When deployed directly on Ethio Telecom hosting (cPanel / Linux): use localhost or 127.0.0.1
# When accessing remotely: use lin1.ethiotelecom.et or your domain (eradashboard.com.et)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=eradashb_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=eradashb_db
# Optional UNIX socket for cPanel hosting (e.g. /var/lib/mysql/mysql.sock)
MYSQL_SOCKET=
# SSL configuration (false for traditional localhost/cPanel connections)
MYSQL_SSL=false
# Character set for Amharic / Ge'ez and international text support
MYSQL_CHARSET=utf8mb4
# Timezone (Africa/Addis_Ababa is +03:00)
MYSQL_TIMEZONE=+03:00
# Alternative full connection URL
DATABASE_URL=mysql://eradashb_user:your_mysql_password@localhost:3306/eradashb_db

# Gemini AI Key
GEMINI_API_KEY=

