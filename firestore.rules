rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check (connection probe only; no client writes permitted)
    match /test/{testId} {
      allow read: if isSignedIn() && isValidId(testId);
      allow write: if false;
    }

    // Projects - Read for signed-in users, Write for Admins only
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(projectId) && isAdmin();
    }

    // Deleted Projects - Admin access
    match /deleted_projects/{deletedProjectId} {
      allow read: if isAdmin();
      allow write: if isValidId(deletedProjectId) && isAdmin();
    }

    // Users - Read/Write for owner or admin
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    // Approvals - Restricted access
    match /approvals/{approvalId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(approvalId) && isAdmin();
    }

    // Private Drafts - Authenticated access with ID guard
    match /private_drafts/{draftId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(draftId);
    }

    // Progress Plan History Backups - Signed-in read, Admin write
    match /progress_plan_history_backups/{projectId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(projectId) && isAdmin();
    }

    // Workflow Audit Logs - Admin access
    match /workflow_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isValidId(logId) && isAdmin();
    }

    // Config - Admin write access
    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isValidId(configId) && isAdmin();
    }
  }
}
