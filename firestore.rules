rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check
    match /test/{testId} {
      allow read: if true;
      allow write: if true;
    }

    // Projects - Read for all, Write for Admins only
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isAdmin());
    }

    // Deleted Projects - Read only for Admins
    match /deleted_projects/{deletedProjectId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Users - Read for owner/admin, Write for owner/admin
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Approvals - Restricted access
    match /approvals/{approvalId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isAdmin());
    }

    // Private Drafts - Owner access
    match /private_drafts/{draftId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Workflow Audit Logs - Admin access
    match /workflow_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Config - Admin write access
    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
